# ==========================================
# LLM Provider Configuration
# ==========================================
# Options: openai | gemini | azure | openai_compatible
LLM_PROVIDER=openai
LLM_TIMEOUT=30.0
# Số lần thử lại khi LLM lỗi tạm thời (mạng, timeout, 408/409/429/5xx). Chỉ có một tầng
# retry (SDK không tự retry): tối đa 1 + LLM_MAX_RETRIES request cho mỗi lời gọi.
LLM_MAX_RETRIES=2
# Deadline tổng (giây, >= 5) cho phần LLM của một lượt chat: viết lại câu hỏi, sinh đa
# truy vấn và sinh câu trả lời (tới chunk đầu tiên khi stream). Hết deadline thì trả câu
# trả lời dự phòng hoặc event lỗi. Giữ nhỏ hơn proxy_read_timeout của nginx (300s).
LLM_TURN_DEADLINE_SECONDS=60
LLM_TEMPERATURE=0.0
# Stream reasoning tokens (reasoning_content/thought) to /chat/stream events.
# Turn off for legacy models that reject includeThoughts (e.g. Gemini 1.5).
LLM_REASONING_STREAM_ENABLED=true

# 1. OpenAI Configuration (Default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Google Gemini Configuration (When LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. Azure OpenAI Configuration (When LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# 4. OpenAI-Compatible / Local Model (vLLM, Ollama, LocalAI - When LLM_PROVIDER=openai_compatible)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=llama3

# Evaluation Models (Ragas)
RAGAS_JUDGE_MODEL=gpt-4.1-mini
RAGAS_EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# Database & pgvector Configuration (PostgreSQL 16)
# ==========================================
DATABASE_URL=postgresql+psycopg://ptit_user:ptit_password@localhost:5433/ptit_chatbot

POSTGRES_DB=ptit_chatbot
POSTGRES_USER=ptit_user
POSTGRES_PASSWORD=ptit_password
POSTGRES_PORT=5433

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# ==========================================
# Embedding Configuration
# ==========================================
# openai | sentence-transformers | hash. `hash` chỉ dùng cho test/phát triển (vector băm,
# không có nghĩa ngữ nghĩa); không còn tự quay về hash khi provider lỗi.
# Thiếu key (EMBEDDING_API_KEY hoặc OPENAI_API_KEY) thì app vẫn chạy: /api/health báo
# embedding "not_configured", chat trả 503 cho tới khi admin nhập key ở trang cấu hình.
# VECTOR_DIM phải bằng số chiều cột vector trong DB (1536).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIM=1536

# ==========================================
# Document Knowledge Base
# ==========================================
DOCUMENTS_PATH=data
# PDF/DOCX are converted to Markdown by Docling (pip install -e ".[docling]") and cached here.
CONVERTED_DOCUMENTS_PATH=backend/storage/converted
# Enable only for scanned PDFs without a text layer; OCR is much slower.
DOCLING_OCR_ENABLED=false
# auto | cpu | cuda | cuda:N. "auto" uses the GPU when torch was installed with CUDA support.
DOCLING_DEVICE=auto
# Optional LlamaParse parser (pip install -e ".[llamaparse]"): admins pick it per document;
# Docling stays the default. Files are uploaded to LlamaCloud and cost credits per page.
LLAMAPARSE_ENABLED=false
LLAMA_CLOUD_API_KEY=
# fast | cost_effective | agentic | agentic_plus (1 / 3 / 10 / 45 credits per page)
LLAMAPARSE_TIER=cost_effective
LLAMAPARSE_VERSION=latest
LLAMAPARSE_LANGUAGE=vi
LLAMAPARSE_TIMEOUT_SECONDS=900
# Leave empty for the default region; set e.g. https://api.cloud.eu.llamaindex.ai for EU.
LLAMAPARSE_BASE_URL=

CHUNK_SIZE=900
CHUNK_OVERLAP=150
PARENT_CHILD_CHUNKING_ENABLED=true
CHILD_CHUNK_SIZE=450
CHILD_CHUNK_OVERLAP=75

HYBRID_VECTOR_WEIGHT=0.65
HYBRID_CANDIDATE_MULTIPLIER=4
HYBRID_RRF_K=60

# Confidence gate (RAG-18): LLM is only called when every calibrated signal clears its
# threshold. Thresholds come from documents/rag-eval/rag-18/; re-run
# `python -m scripts.eval_confidence --sweep` after large corpus changes.
# Normalized BM25 in [0, 1] (query-relative upper bound), always used.
RETRIEVAL_MIN_BM25_NORM_SCORE=0.25
# Cosine floor per embedding model: leave empty to use the calibrated table in
# app/generation/confidence.py (text-embedding-3-small: 0.37). An uncalibrated model
# drops the vector signal with a warning. The old default 0.30 is treated as unset.
RETRIEVAL_MIN_VECTOR_SCORE=
# Cross-encoder logit floor, only used with RERANKER_PROVIDER=cross-encoder; empty uses
# the calibrated table (cross-encoder/mmarco-mMiniLMv2-L12-H384-v1: -1.65). The heuristic
# reranker scores are relative within each candidate list, so they are never thresholded.
# The cross-encoder is what lets the gate refuse >80% of unanswerable questions (RAG-18).
RETRIEVAL_MIN_RERANK_SCORE=
# Deprecated: raw BM25 depends on corpus size and is no longer used by the gate.
RETRIEVAL_MIN_BM25_SCORE=2.0
QUERY_REWRITE_USE_LLM=false

MULTI_QUERY_ENABLED=true
MULTI_QUERY_USE_LLM=false
MULTI_QUERY_COUNT=3

CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_MEMORY_MAX_MESSAGES=6
CONVERSATION_MEMORY_MAX_CHARS=6000

RERANKER_ENABLED=true
RERANKER_PROVIDER=heuristic
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_CANDIDATE_MULTIPLIER=3
RERANKER_VECTOR_WEIGHT=0.45
RERANKER_BM25_WEIGHT=0.35
RERANKER_LEXICAL_WEIGHT=0.20

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Admin authentication (/admin)
# ==========================================
# Both required to enable the admin page. Admins sign in on the shared /login page
# with this email (must be a valid email address) and a long, unique password.
# Either empty -> admin login is disabled and every admin API returns 401.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Key used to sign the ptit_admin session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty -> a temporary key is generated at startup and all admin sessions end on restart.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12
# Set true when served over HTTPS (applies to ptit_admin, ptit_user and ptit_sid cookies).
COOKIE_SECURE=false
# Reverse proxies (IP or CIDR, comma-separated) whose X-Forwarded-For is trusted to find the
# real client IP for login throttling. Empty -> the direct connection IP (behind a proxy every
# user then shares the proxy IP). docker-compose.yml defaults to the private ranges.
TRUSTED_PROXY_IPS=
# Origins (scheme://host[:port], comma-separated, wildcard host like https://*.openai.azure.com)
# allowed for LLM base_url/endpoint in PUT /api/config and POST /api/config/test-llm.
# Empty -> https://api.openai.com plus the origins of OPENAI_BASE_URL, OPENAI_COMPATIBLE_BASE_URL
# and AZURE_OPENAI_ENDPOINT above.
LLM_BASE_URL_ALLOWLIST=
# Encrypts API keys saved from the admin UI (stored in PostgreSQL, table app_config_overrides).
# Settings changed on the admin page survive restarts and override this file. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty or invalid -> saving an API key from the UI is refused (other settings still save).
# Rotation: put the new key first, comma-separated with the old one; the next save re-encrypts.
# Losing this key makes saved API keys unreadable (the backend falls back to the keys above).
CONFIG_ENCRYPTION_KEY=

# ==========================================
# Student accounts (/login, /register)
# ==========================================
# Key used to sign the ptit_user session cookie; must differ from ADMIN_SESSION_SECRET.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty -> a temporary key is generated at startup and every user is logged out on restart.
USER_SESSION_SECRET=
USER_SESSION_TTL_DAYS=30
# false -> POST /api/auth/register returns 503 (existing accounts can still log in).
USER_REGISTRATION_ENABLED=true
# Allowed email domains for registration, comma-separated (e.g. stu.ptit.edu.vn,ptit.edu.vn).
# Empty -> any domain.
USER_EMAIL_DOMAINS=
# Throttling: more than N failures within the window -> 429 (login: per IP + email;
# register: duplicate-email hits per IP). Admin login is separate (per IP; ADMIN_EMAIL/ADMIN_PASSWORD).
USER_AUTH_MAX_FAILURES=5
USER_AUTH_WINDOW_SECONDS=300

# ==========================================
# Chat abuse protection (/api/chat, /api/chat/stream)
# ==========================================
# Max question length in characters (whitespace included); longer -> 422.
CHAT_MESSAGE_MAX_CHARS=2000
# false -> no per-owner/per-IP quotas and no one-turn-at-a-time lock (length check stays on).
CHAT_RATE_LIMIT_ENABLED=true
# Questions per owner (signed-in account, or anonymous ptit_sid session). Over -> 429 + Retry-After.
CHAT_RATE_OWNER_PER_MINUTE=10
CHAT_RATE_OWNER_PER_DAY=200
# Questions per client IP (stops clearing cookies to reset the owner quota). Set well above the
# owner quota: many students may share one public IP (campus wifi, NAT). The IP comes from
# TRUSTED_PROXY_IPS above; if that is wrong behind a proxy, every user shares the proxy IP.
CHAT_RATE_IP_PER_MINUTE=60
CHAT_RATE_IP_PER_DAY=2000
# A value <= 0 disables only that quota. A signed-in admin (ptit_admin) skips the quotas
# but still gets one answer at a time.
# One answer at a time per owner; the lock expires after this many seconds if never released.
CHAT_ACTIVE_SLOT_TTL_SECONDS=600
# Max owners/IPs tracked in memory per quota; the least recently used are dropped beyond it.
CHAT_RATE_LIMIT_MAX_KEYS=100000
# Counters live in the backend process memory (single uvicorn worker) and reset on restart.
# With several workers/instances each one counts separately (shared store: BE-16).

PTIT_AUTO_INGEST=true
